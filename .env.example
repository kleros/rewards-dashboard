# Proof of Humanity v2 Gnosis subgraph (The Graph network gateway URL).
VITE_POH_GNOSIS_SUBGRAPH_URL=

# Public Curate indexer GraphQL URL, required for live Agent Ambassador profiles.
# Set the deployed endpoint locally and in Netlify; this value is browser-visible.
VITE_CURATE_INDEXER_URL=

# Agent Ambassador Program: which Curate lists the section reads.
# gnosis (default) reads the program lists; sepolia reads the test list; preview borrows two live Scout lists.
VITE_AMBASSADOR_PROFILE=gnosis
